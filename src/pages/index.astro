---
import BaseLayout from '../layouts/BaseLayout.astro';
import FlowDiagram from '../components/FlowDiagram.astro';
import { FLOW } from '../lib/flow.ts';
import '../styles/home.css';
import { SITE } from '../lib/site.ts';
import { TOOLS, CATEGORY_ORDER } from '../lib/tools.ts';
import { graph, organizationLd, websiteLd } from '../lib/seo.ts';
import { fetchLatestRelease, fetchCIStatus, fetchGitHubRepoData } from '../lib/github-data.ts';
import { parseRepo } from '../lib/releases.ts';

// Homepage JSON-LD: who we are + this site.
const jsonLd = graph([organizationLd(), websiteLd('Lidless', 'https://lidless.dev')]);

const total = TOOLS.length;
// The hero's copy-a-command button.
const INSTALL = 'npx -y wazuh-mcp';

// Live per-tool health for the grid: last release date + CI status. Build-time,
// static (no hydration). Cached per repo, fails soft, so a card just omits the
// health line when there is no data.
type Health = { updated: string | null; ci: string | null; version: string | null };
const health = new Map<string, Health>();
await Promise.all(
  TOOLS.map(async (t) => {
    const p = parseRepo(t.repo);
    if (!p) return;
    const [rel, ci, repoData] = await Promise.all([
      fetchLatestRelease(p.owner, p.repo),
      fetchCIStatus(p.owner, p.repo),
      fetchGitHubRepoData(p.owner, p.repo),
    ]);
    // "updated" is the repo's last push (pushed_at), the same signal GitHub uses
    // for "Updated N days ago", so it reflects real activity, not the last
    // release. Falls back to the release date if repo data is unavailable.
    // Version is the live latest-release tag, normalized to vX.Y.Z (handles bare
    // v1.2.3 and prefixed tags like "proxmoxctrl v0.5.1").
    const semver = rel?.tag.match(/\d+\.\d+\.\d+/);
    health.set(t.slug, {
      updated: repoData?.updatedAt ?? rel?.publishedAt ?? null,
      ci: ci?.status ?? null,
      version: semver ? `v${semver[0]}` : null,
    });
  }),
);

// Section anchors + ordinals per category, matching the nav.
const CAT_ANCHOR: Record<string, string> = {
  'Security / SOC': 'security',
  'Threat Intelligence & OSINT': 'intel',
  Network: 'network',
  Homelab: 'homelab',
};
const CAT_SHORT: Record<string, string> = {
  'Security / SOC': 'SOC',
  'Threat Intelligence & OSINT': 'Intel',
  Network: 'Network',
  Homelab: 'Homelab',
};
const CAT_BLURB: Record<string, string> = {
  'Security / SOC': 'SIEM, IDS, incident response',
  'Threat Intelligence & OSINT': 'intel and OSINT',
  Network: 'NMS, automation, mesh',
  Homelab: 'hypervisor and self-hosted apps',
};
---
<BaseLayout title={SITE.seoTitle} description={SITE.metaDescription} jsonLd={jsonLd}>
  <main class="home wrap">
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-copy">
        <h1 id="hero-title">Watch your whole stack<br /> <span class="hero-second">from one agent.</span></h1>
        <p class="hero-lead">
          MCP servers and CLIs that put Wazuh, MISP, TheHive, LibreNMS, and Proxmox in reach of your AI client.
        </p>
        <div class="hero-ctas">
          <a class="btn solid" href="#tools">Browse tools</a>
          <button class="btn dashed" type="button" data-copy={INSTALL} aria-label={`Copy ${INSTALL}`}>
            <code>{INSTALL}</code><span data-copy-label aria-hidden="true">Copy</span>
          </button>
        </div>
      </div>
      <div class="eye-panel">
      <svg class="lid-eye mt-6" viewBox="0 0 120 120" width="200" height="200"
        role="img" aria-label="The Lidless eye - it follows your cursor and never closes.">
        <defs>
          <radialGradient id="ls" cx="40%" cy="34%" r="74%"><stop offset="0%" stop-color="#fbfdfe"/><stop offset="44%" stop-color="#dde4e9"/><stop offset="80%" stop-color="#aeb8bf"/><stop offset="100%" stop-color="#828c93"/></radialGradient>
          <radialGradient id="li" cx="46%" cy="40%" r="62%"><stop offset="0%" stop-color="#c9edff"/><stop offset="36%" stop-color="#4db4ec"/><stop offset="76%" stop-color="#1f7fb0"/><stop offset="100%" stop-color="#0a2540"/></radialGradient>
          <linearGradient id="ringG" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#41566e"/><stop offset="45%" stop-color="#243447"/><stop offset="100%" stop-color="#121c29"/></linearGradient>
          <radialGradient id="innerShadow" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="#070b11" stop-opacity="0"/><stop offset="74%" stop-color="#070b11" stop-opacity="0"/><stop offset="100%" stop-color="#070b11" stop-opacity="0.6"/></radialGradient>
          <radialGradient id="irisHi" cx="38%" cy="30%" r="45%"><stop offset="0%" stop-color="#ffffff" stop-opacity="0.55"/><stop offset="100%" stop-color="#ffffff" stop-opacity="0"/></radialGradient>
          <clipPath id="lc"><circle cx="60" cy="60" r="43"/></clipPath>
        </defs>
        <circle cx="60" cy="60" r="53" fill="none" stroke="#38bdf8" stroke-width="1.2" opacity="0.4"/>
        <circle cx="60" cy="60" r="50" fill="none" stroke="url(#ringG)" stroke-width="6"/>
        <circle cx="60" cy="60" r="46.9" fill="none" stroke="#38bdf8" stroke-width="1.2" opacity="0.7"/>
        <circle cx="60" cy="60" r="44" fill="url(#ls)"/>
        <g clip-path="url(#lc)"><g class="eyeball">
          <circle cx="60" cy="60" r="17" fill="url(#li)"/>
          <circle cx="60" cy="60" r="17" fill="none" stroke="#0a2540" stroke-width="1.7" opacity="0.9"/>
          <circle cx="60" cy="60" r="7.6" fill="#040e1b"/>
          <circle cx="60" cy="60" r="7.6" fill="none" stroke="#000" stroke-width="0.8" opacity="0.45"/>
          <ellipse cx="55" cy="53" rx="4.6" ry="3" fill="url(#irisHi)"/>
          <circle cx="63.6" cy="55.4" r="2.5" fill="#fff" opacity="0.95"/>
        </g></g>
        <circle cx="60" cy="60" r="44" fill="url(#innerShadow)" pointer-events="none"/>
        <ellipse cx="48" cy="40" rx="24" ry="12" fill="#ffffff" opacity="0.12" clip-path="url(#lc)" pointer-events="none"/>
      </svg>
      <script is:inline>
        (() => {
          const e = document.querySelector('.lid-eye');
          if (!e) return;
          // Respect prefers-reduced-motion: leave the eye open and centered, but
          // skip the cursor/scroll tracking loop and its listeners entirely.
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
          const b = e.querySelector('.eyeball');
          let mx = null, my = null, cx = 0, cy = 0, ly = 0, gl = 0, tMouse = -1e9, tScroll = -1e9, touching = false;
          const MAX = 14, MAXY = 12, NEAR = 620;
          // Track both inputs; whichever moved most recently drives the eye. This
          // way the cursor leads on desktop, but scrolling (wheel / trackpad /
          // touch) takes over the moment you scroll, on every device.
          addEventListener('mousemove', (v) => { mx = v.clientX; my = v.clientY; tMouse = v.timeStamp; }, { passive: true });
          // Touch screens: the eye follows your finger while it is down, even
          // mid-swipe; once the finger lifts, scrolling takes over again.
          const touch = (v) => { const t = v.touches[0]; if (!t) return; mx = t.clientX; my = t.clientY; tMouse = v.timeStamp; touching = true; };
          const lift = (v) => { touching = v.touches.length > 0; };
          addEventListener('touchstart', touch, { passive: true });
          addEventListener('touchmove', touch, { passive: true });
          addEventListener('touchend', lift, { passive: true });
          addEventListener('touchcancel', lift, { passive: true });
          addEventListener('scroll', (v) => { tScroll = v.timeStamp; }, { passive: true });
          (function f() {
            let tx = 0, ty = 0;
            const r = e.getBoundingClientRect();
            gl += ((scrollY - ly) - gl) * 0.2; ly = scrollY;   // smoothed scroll velocity, every frame
            if (mx != null && (touching || tMouse >= tScroll) && r.width) {
              const ex = r.left + r.width / 2, ey = r.top + r.height / 2,
                dx = mx - ex, dy = my - ey, d = Math.hypot(dx, dy) || 1;
              if (d < NEAR) {
                tx = Math.max(-MAX, Math.min(MAX, dx / d * MAX));
                ty = Math.max(-MAXY, Math.min(MAXY, dy / d * MAXY));
              }
            } else {
              // scrolling (or touch / mobile with no finger down): the eye watches the
              // middle of the screen, so it looks down as you scroll it up out of view
              // and back up as it returns, and glances a little further in the
              // direction you're scrolling, easing back when you stop. Measured
              // against the viewport, not the whole page, so it moves visibly in the
              // few hundred pixels the eye is actually on screen.
              const ey = r.top + r.height / 2;
              const v = (innerHeight / 2 - ey) / (innerHeight / 2);  // -1..1, + = screen middle is below the eye
              const g = Math.max(-1, Math.min(1, gl / 26));         // -1..1 glance amount
              ty = Math.max(-MAXY, Math.min(MAXY, v * MAXY + g * 4));
            }
            cx += (tx - cx) * 0.14; cy += (ty - cy) * 0.14;
            b.setAttribute('transform', 'translate(' + cx.toFixed(2) + ' ' + cy.toFixed(2) + ')');
            requestAnimationFrame(f);
          })();
        })();
      </script>
        <span class="motto mono">{SITE.motto.toLowerCase().replace(/\.$/, '')}</span>
      </div>
    </section>

    <section class="home-section wide" aria-labelledby="flow-title">
      <h2 id="flow-title">{FLOW.title}</h2>
      <p class="section-lead">{FLOW.lead}</p>
      <FlowDiagram />
    </section>

    <section id="tools" class="home-section wide tools" aria-labelledby="tools-title">
      <div class="tools-head">
        <div>
          <h2 id="tools-title">Tools</h2>
          <p class="section-lead">{total} tools, all MIT. Each one wires a real system into your AI client.</p>
        </div>
        <div class="tabs" id="toolTabs" role="group" aria-label="Filter by category">
          <button type="button" data-cat="all" aria-pressed="true">All</button>
          {CATEGORY_ORDER.map((c) => <button type="button" data-cat={CAT_ANCHOR[c]} aria-pressed="false">{CAT_SHORT[c]}</button>)}
        </div>
      </div>
      <div class="filter">
        <label class="sr-only" for="toolFilter">Filter tools</label>
        <input id="toolFilter" type="search" placeholder="Filter tools" autocomplete="off" />
      </div>

      <div id="toolIndex">
        {CATEGORY_ORDER.map((cat) => {
          const inCat = TOOLS.filter((t) => t.category === cat);
          return (
            <section class="sec group" id={CAT_ANCHOR[cat]} data-cat={CAT_ANCHOR[cat]}>
              <h3 class="label">{cat}<small><span class="count">{inCat.length}</span> tools &middot; {CAT_BLURB[cat]}</small></h3>
              <div>
                {inCat.map((t) => {
                  const h = health.get(t.slug);
                  const ext = Boolean(t.href);
                  return (
                    <a class="row" href={t.href ?? `/${t.slug}`} target={ext ? '_blank' : undefined} rel={ext ? 'noopener noreferrer' : undefined}
                      data-q={`${t.name} ${t.oneLiner}`.toLowerCase()}>
                      <span class="n">{t.name}</span>
                      <span class="d">{t.oneLiner}</span>
                      {h?.version && <span class="v">{h.version}</span>}
                      {t.lifecycle !== 'Active' && <span class="v">{t.lifecycle}</span>}
                      <span class="go" aria-hidden="true">{ext ? '\u2197' : '\u2192'}</span>
                    </a>
                  );
                })}
              </div>
            </section>
          );
        })}
        <p class="no-match" id="noMatch" hidden>No tools match.</p>
      </div>
    </section>

    <section class="home-section" aria-labelledby="behave-title">
      <h2 id="behave-title">How every tool behaves</h2>
      <dl class="behave">
        <div><dt>Read-only by default</dt><dd>Anything that changes state needs an explicit confirm. Your agent looks before it touches.</dd></div>
        <div><dt>Runs on your machine</dt><dd>The servers run beside your client over stdio. Credentials stay in your environment.</dd></div>
        <div><dt>Learn it once</dt><dd>Every tool is configured and gated the same way. <a href="/docs">The docs</a> cover all of it.</dd></div>
      </dl>
    </section>
  </main>

  <script is:inline>
    (() => {
      const tabs = document.getElementById('toolTabs');
      const input = document.getElementById('toolFilter');
      const groups = [...document.querySelectorAll('#toolIndex .group')];
      const none = document.getElementById('noMatch');
      let cat = 'all';
      const apply = () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        groups.forEach((g) => {
          let n = 0;
          g.querySelectorAll('.row').forEach((r) => {
            const hit = !q || r.dataset.q.includes(q);
            r.hidden = !hit;
            if (hit) n++;
          });
          g.hidden = (cat !== 'all' && g.dataset.cat !== cat) || n === 0;
          g.querySelector('.count').textContent = n;
          if (!g.hidden) shown++;
        });
        none.hidden = shown > 0;
      };
      tabs.addEventListener('click', (e) => {
        const b = e.target.closest('button');
        if (!b) return;
        cat = b.dataset.cat;
        tabs.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        apply();
      });
      input.addEventListener('input', apply);
    })();
  </script>

</BaseLayout>
