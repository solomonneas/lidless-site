---
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getReleasePosts, releaseAnchor, type ReleasePost } from '../../lib/releases.ts';
import { PAGES } from '../../lib/tool-pages.ts';
import { SITE } from '../../lib/site.ts';
import { graph, breadcrumbLd, canonicalFor } from '../../lib/seo.ts';

export async function getStaticPaths() {
  const posts = await getReleasePosts();
  // prev/next within the same tool (older = prev, newer = next).
  const byTool = new Map<string, ReleasePost[]>();
  for (const p of posts) {
    const arr = byTool.get(p.toolSlug) ?? [];
    arr.push(p);
    byTool.set(p.toolSlug, arr);
  }
  return posts.map((post) => {
    const siblings = byTool.get(post.toolSlug)!; // already date-desc
    const i = siblings.findIndex((s) => s.slug === post.slug);
    return {
      params: { slug: post.slug },
      props: {
        post,
        prev: siblings[i + 1] ?? null,
        next: siblings[i - 1] ?? null,
      },
    };
  });
}

const { post, prev, next } = Astro.props as {
  post: ReleasePost;
  prev: ReleasePost | null;
  next: ReleasePost | null;
};


const bodyHtml = post.body ? await marked.parse(post.body) : '';

const siteUrl = (Astro.site ?? new URL(SITE.url)).toString();
const canonical = canonicalFor(siteUrl, Astro.url.pathname);
const title = `${post.tool} ${post.tag}`;
const description = post.name && post.name !== post.tag ? post.name : `${post.tool} ${post.tag} release notes.`;

const jsonLd = graph([
  {
    '@type': 'Article',
    headline: title,
    description,
    datePublished: post.date,
    dateModified: post.date,
    mainEntityOfPage: canonical,
    url: canonical,
  },
  breadcrumbLd([
    { name: 'Lidless', url: 'https://lidless.dev' },
    { name: 'The Log', url: 'https://lidless.dev/blog' },
    { name: title, url: canonical },
  ]),
]);

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const hasPage = Boolean(PAGES[post.toolSlug]);
const words = post.body.trim().split(/\s+/).filter(Boolean).length;
---
<BaseLayout title={title} description={description} jsonLd={jsonLd} robots="noindex, follow">
  <main>
    <header class="phead">
      <div class="wrap"><div class="frame">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Lidless Labs</a> / <a href="/blog">Changelog</a> / <a href={`/changelog/${post.toolSlug}`}>{post.tool}</a> / <span>{post.tag}</span>
        </nav>
        <h1><span class="mono">{post.tool}</span> <span class="ver">{post.tag}</span></h1>
        <div class="meta mono">
          <span>{fmt(post.date)}</span><span>{post.category}</span><a href={`https://github.com/${post.repo}`}>{post.repo}</a>
        </div>
        <div class="actions">
          {hasPage && <a class="btn solid" href={`/${post.toolSlug}`}>About {post.tool} &rarr;</a>}
          <a class="btn" href={`/changelog/${post.toolSlug}#${releaseAnchor(post.version)}`}>Full changelog</a>
          <a class="btn" href={post.url} rel="noopener">Release on GitHub &#8599;</a>
        </div>
      </div></div>
    </header>

    <div class="wrap">
      <section class="sec">
        <h2 class="label">Release notes{bodyHtml && <small>{words} words</small>}</h2>
        {bodyHtml ? (
          <article class="prose" set:html={bodyHtml} />
        ) : (
          <p class="empty-note">No written notes for {post.tag}. The diff is on <a href={post.url}>GitHub</a>.</p>
        )}
      </section>

      <nav class="pager" aria-label={`Other ${post.tool} releases`}>
        {prev ? <a href={`/blog/${prev.slug}`}><div class="l">&larr; older</div><div class="t">{prev.tag}</div></a> : <span></span>}
        {next ? <a href={`/blog/${next.slug}`}><div class="l">newer &rarr;</div><div class="t">{next.tag}</div></a> : <span></span>}
      </nav>
    </div>
  </main>

  <style>
    .ver { color: var(--text-dim); font-weight: 500; }
    .meta { display: flex; flex-wrap: wrap; gap: 8px 18px; margin-top: 16px; font-size: 13px; color: var(--text-dim); }
    .meta a { color: var(--text-muted); }
    .meta a:hover { color: var(--text); }
    .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  </style>
</BaseLayout>
