---
import BaseLayout from '../layouts/BaseLayout.astro';
import { TOOLS } from '../lib/tools.ts';
import { PAGES } from '../lib/tool-pages.ts';
import { parseRepo } from '../lib/releases.ts';
import { fetchLatestRelease, fetchCIStatus, fetchGitHubRepoData, formatRelativeDate } from '../lib/github-data.ts';
import { softwareApplicationLd, organizationLd, absoluteImage, graph } from '../lib/seo.ts';

export function getStaticPaths() {
  return Object.keys(PAGES).map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const tool = TOOLS.find((t) => t.slug === slug)!;
const page = PAGES[slug!]!;
const { name, lifecycle, category, repo, npm } = tool;

const pageUrl = `https://lidless.dev/${slug}`;
const title = name;
const description = page.value.replace(/\s+/g, ' ').slice(0, 155);
const jsonLd = graph([
  organizationLd(),
  softwareApplicationLd({
    name,
    siteUrl: pageUrl,
    description,
    image: absoluteImage('https://lidless.dev', '/og-card.png'),
    codeRepository: repo,
    license: 'MIT',
  }),
]);

const catAnchor: Record<string, string> = {
  'Security / SOC': 'security',
  'Threat Intelligence & OSINT': 'intel',
  Network: 'network',
  Homelab: 'homelab',
};

// Repo health for the facts panel, fetched at build time. Fails soft: a row
// shows a dash when GitHub has no data (no releases, no CI, rate limit).
const parsed = parseRepo(repo);
const [repoData, release, ci] = parsed
  ? await Promise.all([
      fetchGitHubRepoData(parsed.owner, parsed.repo),
      fetchLatestRelease(parsed.owner, parsed.repo),
      fetchCIStatus(parsed.owner, parsed.repo),
    ])
  : [null, null, null];
const semver = release?.tag.match(/\d+\.\d+\.\d+/);
const version = semver ? `v${semver[0]}` : null;
const ciLabel: Record<string, string> = { success: 'passing', failure: 'failing', pending: 'running', cancelled: 'cancelled', skipped: 'skipped' };
const pushed = repoData?.updatedAt ?? null;

// The hero install line is the first command of the setup block.
const install = page.setup?.install?.split('#')[0].trim();
// Tags under the CTAs: drop the ones the facts panel already shows.
const specText = new Set(['mit', ...page.specs.map((s) => `${s.n} ${s.l}`.toLowerCase())]);
const tags = page.meta.filter((m) => !specText.has(m.toLowerCase()) && !/^\d+ (tools|resources|prompts)$/i.test(m));
const nums = page.specs.filter((s) => s.l.toLowerCase() !== 'license').slice(0, 4);

// "More in <category>" and prev / next through the tools that have pages.
const more = TOOLS.filter((t) => t.category === category && t.slug !== slug);
const paged = TOOLS.filter((t) => PAGES[t.slug]);
const i = paged.findIndex((t) => t.slug === slug);
const prev = paged[(i - 1 + paged.length) % paged.length];
const next = paged[(i + 1) % paged.length];

// Setup env text with variable names set in code style.
const envHtml = (page.setup?.env ?? '')
  .replace(/&/g, '&amp;')
  .replace(/</g, '&lt;')
  .replace(/\b([A-Z][A-Z0-9]*_[A-Z0-9_]{2,})\b/g, '<code class="i">$1</code>');

const who: Record<string, string> = { ask: 'you', call: 'tool', ret: 'result', say: 'agent' };
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <main>
    <header class="tp-hero">
      <div class="wrap">
        <div class="tp-copy">
          <nav class="crumb" aria-label="Breadcrumb">
            <a href="/">Lidless Labs</a> / <a href={`/#${catAnchor[category] ?? 'tools'}`}>{category}</a> / <span>{name}</span>
          </nav>
          <div class="titlerow">
            <h1 class="mono">{name}</h1>
            <span class="status">{lifecycle}</span>
          </div>
          <p class="value" set:html={page.value.replace(name, `<b>${name}</b>`)}></p>
          <div class="cta">
            <a class="btn solid" href={repo} rel="noopener">GitHub repo &rarr;</a>
            {npm && <a class="btn" href={`https://www.npmjs.com/package/${npm}`} rel="noopener">npm &rarr;</a>}
          </div>
          {install && <div class="install mono"><span class="p">$</span><span class="cmd term">{install}</span></div>}
          {tags.length > 0 && <div class="tags mono">{tags.map((t) => <span>{t}</span>)}</div>}
        </div>

        <aside class="facts" aria-label="At a glance">
          <div class="k mono">at a glance</div>
          {nums.length > 0 && <div class="nums">{nums.map((s) => <div><b>{s.n}</b>{s.l}</div>)}</div>}
          <dl>
            <div><dt>version</dt><dd class="mono">{version ?? '—'}</dd></div>
            <div><dt>ci</dt><dd class:list={['mono', ci && `ci-${ci.status}`]}>{ci ? ciLabel[ci.status] : '—'}</dd></div>
            <div><dt>last push</dt><dd class="mono">{pushed ? formatRelativeDate(pushed) : '—'}</dd></div>
            <div><dt>category</dt><dd class="mono">{category}</dd></div>
            <div><dt>package</dt><dd class="mono">{npm ? <a href={`https://www.npmjs.com/package/${npm}`}>npm &middot; {npm}</a> : 'run from source'}</dd></div>
            <div><dt>source</dt><dd class="mono"><a href={repo}>{parsed ? `${parsed.owner}/${parsed.repo}` : repo}</a></dd></div>
            <div><dt>changelog</dt><dd class="mono"><a href={`/changelog/${slug}`}>all releases &rarr;</a></dd></div>
            <div><dt>license</dt><dd class="mono">MIT</dd></div>
          </dl>
        </aside>
      </div>
    </header>

    <div class="wrap">
      {page.proof.type === 'session' && (
        <section class="sec">
          <h2 class="label">See it work<small>representative session</small></h2>
          <div>
            <div class="session">
              {page.proof.turns.map((t) => {
                const [k, v] = Object.entries(t)[0] as [string, string];
                return (
                  <div class:list={['turn', k]}>
                    <span class="who mono">{who[k]}</span>
                    <div class:list={['t', (k === 'call' || k === 'ret') && 'mono']}>{v}</div>
                  </div>
                );
              })}
            </div>
            <p class="note">{page.proof.caption}</p>
          </div>
        </section>
      )}
      {page.proof.type === 'screenshot' && (
        <section class="sec">
          <h2 class="label">See it work</h2>
          <figure class="shot">
            <img src={page.proof.src} alt={page.proof.alt} loading="lazy" />
            <figcaption class="note">{page.proof.caption}</figcaption>
          </figure>
        </section>
      )}

      <section class="sec">
        <h2 class="label">What it does</h2>
        <p class="body">{page.what}</p>
      </section>

      {page.capabilities && (
        <section class="sec">
          <h2 class="label">Capabilities<small>{page.capabilities.title}</small></h2>
          <div>
            <div class="caps">
              {page.capabilities.groups.map((g) => (
                <div class="cap">
                  <div class="top"><h3>{g.name}</h3>{g.count && <span class="c mono">{g.count}</span>}</div>
                  <p>{g.desc}</p>
                </div>
              ))}
            </div>
            {page.capabilities.refHref && <a class="ref" href={page.capabilities.refHref} rel="noopener">Full tool reference on GitHub &rarr;</a>}
          </div>
        </section>
      )}

      {page.setup && (
        <section class="sec">
          <h2 class="label">Setup</h2>
          <div class="steps">
            {page.setup.install && (
              <div class="step"><div class="k mono">01 &middot; install</div><div class="code"><pre class="term">{page.setup.install}</pre></div></div>
            )}
            {page.setup.env && (
              <div class="step"><div class="k mono">02 &middot; configure</div><p set:html={envHtml}></p></div>
            )}
            {page.setup.config && (
              <div class="step"><div class="k mono">03 &middot; {(page.setup.configLabel ?? 'client config').toLowerCase()}</div><div class="code"><pre class="term">{page.setup.config}</pre></div></div>
            )}
          </div>
        </section>
      )}

      {page.safety && (
        <section class="sec">
          <h2 class="label">Safety</h2>
          <div class="safety"><div class="k mono">how it stays safe</div>{page.safety}</div>
        </section>
      )}

      {more.length > 0 && (
        <section class="sec">
          <h2 class="label">More in {category}<small>{more.length} tools</small></h2>
          <div>
            {more.map((t) => (
              <a class="row" href={t.href ?? `/${t.slug}`} target={t.href ? '_blank' : undefined} rel={t.href ? 'noopener noreferrer' : undefined}>
                <span class="n">{t.name}</span><span class="d">{t.oneLiner}</span><span class="go" aria-hidden="true">{t.href ? '↗' : '→'}</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <nav class="pager" aria-label="More tools">
        <a href={`/${prev.slug}`}><div class="l">&larr; previous</div><div class="t">{prev.name}</div></a>
        <a href={`/${next.slug}`}><div class="l">next &rarr;</div><div class="t">{next.name}</div></a>
      </nav>
    </div>
  </main>
</BaseLayout>

<style>
  .tp-hero { border-bottom: 1px solid var(--hairline); }
  .tp-hero .wrap { display: grid; grid-template-columns: 1.6fr 1fr; border-left: 1px solid var(--hairline); border-right: 1px solid var(--hairline); }
  .tp-copy { padding: 36px 44px 52px 40px; min-width: 0; }
  .tp-copy .crumb { margin-bottom: 40px; }
  .titlerow { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  h1 { font-size: 44px; line-height: 1.05; letter-spacing: -.04em; font-weight: 600; margin: 0; overflow-wrap: anywhere; }
  .status { font-size: 12px; color: var(--text-muted); border: 1px solid var(--hairline-strong); border-radius: 999px; padding: 3px 10px; }
  .value { color: var(--text-muted); font-size: 16.5px; max-width: 560px; margin: 16px 0 26px; }
  .value :global(b) { color: var(--text); font-weight: 500; }
  .cta { display: flex; gap: 10px; flex-wrap: wrap; }
  .install { margin-top: 22px; display: flex; align-items: center; gap: 12px; max-width: 460px; height: 42px; padding: 0 12px 0 14px; border: 1px solid var(--hairline-strong); border-radius: 8px; background: var(--bg-panel); font-size: 13px; color: var(--text-muted); position: relative; }
  .install .p { color: var(--text-dim); }
  .install :global(.term-wrap) { position: static; flex: 1; min-width: 0; }
  .install .cmd { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; padding-right: 52px; }
  .install :global(.copy-btn) { top: 50%; transform: translateY(-50%); }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 22px; }
  .tags span { font-size: 12px; color: var(--text-muted); border: 1px solid var(--hairline); border-radius: 6px; padding: 2px 8px; }

  .facts { border-left: 1px solid var(--hairline); padding: 36px 32px; min-width: 0; }
  .facts .k { font-size: 12px; color: var(--text-dim); margin-bottom: 14px; }
  .nums { display: flex; flex-wrap: wrap; gap: 6px 20px; padding-bottom: 18px; margin-bottom: 6px; border-bottom: 1px solid var(--hairline); }
  .nums div { font-size: 13px; color: var(--text-dim); }
  .nums b { font-size: 20px; font-weight: 600; color: var(--text); letter-spacing: -.02em; margin-right: 5px; }
  dl { margin: 0; }
  dl > div { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-bottom: 1px solid var(--hairline); font-size: 13px; }
  dl > div:last-child { border-bottom: 0; }
  dt { color: var(--text-dim); }
  dd { margin: 0; color: var(--text-muted); text-align: right; overflow-wrap: anywhere; }
  dd a:hover { color: var(--text); }
  dd.ci-failure { color: var(--danger); }
  dd.ci-pending { color: var(--warn); }

  .session { border: 1px solid var(--hairline-strong); border-radius: 12px; overflow: hidden; }
  .turn { display: grid; grid-template-columns: 64px minmax(0, 1fr); gap: 16px; padding: 14px 18px; border-bottom: 1px solid var(--hairline); }
  .turn:last-child { border-bottom: 0; }
  .turn .who { font-size: 11px; color: var(--text-dim); padding-top: 3px; }
  .turn.ask { background: var(--bg-panel); }
  .turn.ask .t, .turn.say .t { color: var(--text); }
  .turn.call .t { font-size: 13px; color: var(--accent); overflow-wrap: anywhere; }
  .turn.ret .t { font-size: 12.5px; color: var(--text-muted); white-space: pre; overflow-x: auto; line-height: 1.75; }
  .shot { margin: 0; border: 1px solid var(--hairline-strong); border-radius: 12px; overflow: hidden; }
  .shot img { display: block; width: 100%; height: auto; }
  .shot figcaption { padding: 10px 14px; margin: 0; border-top: 1px solid var(--hairline); }

  .body { color: var(--text-muted); font-size: 15.5px; max-width: 680px; margin: 0; }

  .caps { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--hairline); border-left: 1px solid var(--hairline); }
  .cap { padding: 20px 22px; border-right: 1px solid var(--hairline); border-bottom: 1px solid var(--hairline); }
  .cap .top { display: flex; justify-content: space-between; gap: 12px; }
  .cap h3 { margin: 0; font-size: 14px; font-weight: 500; }
  .cap .c { font-size: 12px; color: var(--text-dim); white-space: nowrap; }
  .cap p { margin: 6px 0 0; color: var(--text-muted); font-size: 14px; }
  .ref { display: inline-block; margin-top: 14px; font-size: 13px; color: var(--text-muted); }
  .ref:hover { color: var(--text); }

  .steps { display: grid; gap: 20px; min-width: 0; }
  .step .k { font-size: 12px; color: var(--text-dim); margin-bottom: 8px; }
  .step p { margin: 0; color: var(--text-muted); font-size: 14px; }
  .step .code pre { white-space: pre; }

  .safety { border: 1px solid var(--hairline-strong); border-radius: 12px; padding: 20px 22px; color: var(--text-muted); font-size: 14.5px; }
  .safety .k { color: var(--accent); font-size: 12px; margin-bottom: 8px; }

  @media (max-width: 860px) {
    .tp-hero .wrap { grid-template-columns: 1fr; border: 0; }
    .tp-copy { padding: 32px 0; }
    .tp-copy .crumb { margin-bottom: 24px; }
    h1 { font-size: 34px; }
    .facts { border-left: 0; border-top: 1px solid var(--hairline); padding: 24px 0 32px; }
    .caps { grid-template-columns: 1fr; }
    .turn { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
