---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getReleasePosts, releaseAnchor, type ReleasePost } from '../lib/releases.ts';
import { CATEGORY_ORDER } from '../lib/tools.ts';
import { SITE } from '../lib/site.ts';
import { graph, breadcrumbLd, canonicalFor } from '../lib/seo.ts';

const posts = await getReleasePosts();

const siteUrl = (Astro.site ?? new URL(SITE.url)).toString();
const canonical = canonicalFor(siteUrl, Astro.url.pathname);
const description = 'Release log for the Lidless Labs tools: SOC, network, and homelab MCP servers and apps.';

const jsonLd = graph([
  { '@type': 'Blog', name: 'Lidless Labs changelog', description, url: canonical },
  breadcrumbLd([
    { name: 'Lidless', url: 'https://lidless.dev' },
    { name: 'Changelog', url: canonical },
  ]),
]);

const slugify = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
const CAT_SHORT: Record<string, string> = {
  'Security / SOC': 'SOC',
  'Threat Intelligence & OSINT': 'Intel',
  Network: 'Network',
  Homelab: 'Homelab',
};
const cats = CATEGORY_ORDER.filter((c) => posts.some((p) => p.category === c));
const toolCount = new Set(posts.map((p) => p.toolSlug)).size;

const day = (iso: string) => new Date(iso).toLocaleDateString('en-US', { month: 'short', day: 'numeric', timeZone: 'UTC' });
const month = (iso: string) => new Date(iso).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const href = (p: ReleasePost) => `/changelog/${p.toolSlug}#${releaseAnchor(p.version)}`;

// A release is "thin" when its title only restates the tool and version and
// its notes say nothing more. Thin releases on the same day fold into one row.
// First real sentence of the notes: skip headings ("### Fixed") and stubs.
const firstLine = (md: string) =>
  md
    .split('\n')
    .filter((l) => !/^\s*#/.test(l))
    .map((l) => l.replace(/^\s*([-*]|\d+\.)\s*/, '').replace(/[*_`[\]]/g, '').trim())
    .find((l) => l.split(/\s+/).length >= 3 && !/^full changelog/i.test(l)) ?? '';
const clean = (t: string) => t.replace(/\s+by @\S+ in https?:\/\/\S+/g, '').replace(/\]\([^)]*\)/g, '').trim();
const boiler = (t: string) => /^(patch )?release( readiness)?( for)?\s*[\w.-]*\s*[\d.v]*\.?$/i.test(t.trim());
function summary(p: ReleasePost): string | null {
  const rest = p.name
    .replace(/v?\d+\.\d+\.\d+/g, '')
    .replace(/\b[\w-]*(mcp|ctrl|ctl|cli)\b/gi, '')
    .replace(p.tool, '')
    .trim();
  if (rest.split(/\s+/).filter(Boolean).length >= 2 && !boiler(rest)) return clean(p.name);
  const words = p.body.trim().split(/\s+/).filter(Boolean).length;
  const line = words > 12 ? clean(firstLine(p.body)) : '';
  return line && !boiler(line) ? line : null;
}

type Row = { kind: 'one'; post: ReleasePost; text: string | null } | { kind: 'batch'; posts: ReleasePost[] };
type Group = { month: string; count: number; rows: Row[] };
const groups: Group[] = [];
for (const p of posts) {
  const m = month(p.date);
  let g = groups[groups.length - 1];
  if (!g || g.month !== m) groups.push((g = { month: m, count: 0, rows: [] }));
  g.count++;
  const text = summary(p);
  const last = g.rows[g.rows.length - 1];
  if (!text && last?.kind === 'batch' && day(last.posts[0].date) === day(p.date)) last.posts.push(p);
  else if (!text && last?.kind === 'one' && !last.text && day(last.post.date) === day(p.date)) g.rows[g.rows.length - 1] = { kind: 'batch', posts: [last.post, p] };
  else g.rows.push({ kind: 'one', post: p, text });
}
const catsOf = (ps: ReleasePost[]) => [...new Set(ps.map((p) => slugify(p.category)))].join(' ');
---
<BaseLayout title="Changelog" description={description} jsonLd={jsonLd}>
  <main>
    <header class="phead">
      <div class="wrap"><div class="frame">
        <nav class="crumb" aria-label="Breadcrumb"><a href="/">Lidless Labs</a> / <span>Changelog</span></nav>
        <h1>Changelog</h1>
        <p class="lede">
          {posts.length} releases across {toolCount} tools, newest first. Pulled from each tool's GitHub releases.
          <a href="/blog/rss.xml">RSS</a>
        </p>
      </div></div>
    </header>

    <div class="wrap">
      <div class="bar">
        <label class="sr-only" for="logFilter">Filter releases</label>
        <input id="logFilter" class="mono" type="search" placeholder="Filter by tool or text..." autocomplete="off" />
        {cats.length > 1 && (
          <div class="tabs" id="logTabs" role="group" aria-label="Filter by domain">
            <button type="button" data-cat="all" aria-pressed="true">All</button>
            {cats.map((c) => <button type="button" data-cat={slugify(c)} aria-pressed="false">{CAT_SHORT[c] ?? c}</button>)}
          </div>
        )}
      </div>

      {posts.length === 0 && <p class="empty mono">No releases logged yet. Check back after the next tool ships.</p>}

      <div id="log">
        {groups.map((g) => (
          <section class="sec month">
            <h2 class="label">{g.month}<small>{g.count} release{g.count === 1 ? '' : 's'}</small></h2>
            <div>
              {g.rows.map((r) =>
                r.kind === 'one' ? (
                  <a class="row log" href={href(r.post)} data-cat={slugify(r.post.category)} data-q={`${r.post.tool} ${r.post.name} ${r.post.body}`.toLowerCase()}>
                    <span class="dt mono">{day(r.post.date)}</span>
                    <span class="n">{r.post.tool}</span>
                    <span class:list={['d', !r.text && 'thin']}>{r.text ?? 'Maintenance release'}</span>
                    <span class="tag mono">{r.post.tag}</span>
                  </a>
                ) : (
                  <details class="batch log" data-cat={catsOf(r.posts)} data-q={r.posts.map((p) => `${p.tool} ${p.name}`).join(' ').toLowerCase()}>
                    <summary class="row">
                      <span class="dt mono">{day(r.posts[0].date)}</span>
                      <span class="n">{r.posts.length} releases</span>
                      <span class="d thin">Maintenance: {[...new Set(r.posts.map((p) => p.tool))].join(', ')}</span>
                      <span class="tag mono">show</span>
                    </summary>
                    {r.posts.map((p) => (
                      <a class="row sub" href={href(p)}>
                        <span class="dt"></span>
                        <span class="n">{p.tool}</span>
                        <span class="d thin">no written notes</span>
                        <span class="tag mono">{p.tag}</span>
                      </a>
                    ))}
                  </details>
                ),
              )}
            </div>
          </section>
        ))}
        <p class="empty mono" id="logNone" hidden>No releases match.</p>
      </div>
    </div>
  </main>

  <script is:inline>
    (() => {
      const input = document.getElementById('logFilter');
      const tabs = document.getElementById('logTabs');
      const months = [...document.querySelectorAll('#log .month')];
      const none = document.getElementById('logNone');
      let cat = 'all';
      const apply = () => {
        const q = input.value.trim().toLowerCase();
        let shown = 0;
        months.forEach((m) => {
          let n = 0;
          m.querySelectorAll('.log').forEach((el) => {
            const hit = (cat === 'all' || el.dataset.cat.split(' ').includes(cat)) && (!q || el.dataset.q.includes(q));
            el.hidden = !hit;
            if (hit) n++;
          });
          m.hidden = n === 0;
          if (n) shown++;
        });
        none.hidden = shown > 0;
      };
      input.addEventListener('input', apply);
      if (tabs) tabs.addEventListener('click', (e) => {
        const b = e.target.closest('button');
        if (!b) return;
        cat = b.dataset.cat;
        tabs.querySelectorAll('button').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
        apply();
      });
    })();
  </script>

  <style>
    .bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap; padding: 16px 0; border-bottom: 1px solid var(--hairline); position: sticky; top: 56px; background: rgba(0, 0, 0, .85); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); z-index: 5; }
    .bar input { flex: 1; min-width: 200px; max-width: 360px; background: transparent; border: 0; outline: 0; color: var(--text); font-size: 14px; }
    .bar input::placeholder { color: var(--text-dim); }
    .month > .label { top: 136px; }
    .row.log, .batch summary, .row.sub { display: grid; grid-template-columns: 64px 160px minmax(0, 1fr) auto; gap: 18px; align-items: baseline; }
    .dt { font-size: 12px; color: var(--text-dim); }
    .row .d { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .row .d.thin { color: var(--text-dim); }
    .tag { font-size: 12px; color: var(--text-muted); border: 1px solid var(--hairline); border-radius: 6px; padding: 1px 7px; justify-self: end; }
    .batch { border-bottom: 1px solid var(--hairline); }
    .batch:last-child { border-bottom: 0; }
    .batch summary { list-style: none; cursor: pointer; padding: 13px 0; border-bottom: 0; }
    .batch summary::-webkit-details-marker { display: none; }
    .batch summary:hover .n { color: var(--accent); }
    .batch[open] summary .tag { color: var(--text); }
    .row.sub { padding: 10px 0; border-bottom: 0; border-top: 1px solid var(--hairline); }
    .empty { color: var(--text-dim); padding: 40px 0; }
    @media (max-width: 860px) {
      .month > .label { position: static; }
      .row.log, .batch summary, .row.sub { grid-template-columns: 56px minmax(0, 1fr) auto; gap: 4px 12px; }
      .row.log .d, .batch summary .d, .row.sub .d { grid-column: 2 / -1; grid-row: 2; white-space: normal; }
    }
  </style>
</BaseLayout>
