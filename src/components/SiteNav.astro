---
// Top bar for narrow screens. Above 820px the left rail (SiteRail) carries the
// same links, so this bar is hidden there.
import { EXTERNAL, NAV_LINKS, SITE } from '../lib/site.ts';
import LidlessMark from './LidlessMark.astro';
import ThemeToggle from './ThemeToggle.astro';
---
<header class="site-topbar">
  <a class="site-wordmark" href="/"><LidlessMark />{SITE.formalName}</a>
  <span class="topbar-spacer"></span>
  <details class="topbar-menu">
    <summary class="chip" aria-label="Open site menu">Menu</summary>
    <nav class="topbar-panel" aria-label="Site">
      <a href="/">Home</a>
      {NAV_LINKS.map((l) => <a href={l.href}>{l.label}</a>)}
      <a href={EXTERNAL.github}>GitHub</a>
      <div class="topbar-panel-tools"><ThemeToggle /></div>
    </nav>
  </details>
</header>
