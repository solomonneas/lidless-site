---
import { marked } from 'marked';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TOOLS, TOOL_SLUGS } from '../../lib/tools.ts';
import { PAGES } from '../../lib/tool-pages.ts';
import { getReleasePosts, releaseAnchor, type ReleasePost } from '../../lib/releases.ts';
import { SITE } from '../../lib/site.ts';
import { graph, breadcrumbLd, canonicalFor } from '../../lib/seo.ts';

// One page per tool with releases, newest first. Tools without any fetched
// releases still render (empty state) so the route set is stable when the
// build runs without GITHUB_TOKEN.
export async function getStaticPaths() {
  const posts = await getReleasePosts();
  const byTool = new Map<string, ReleasePost[]>();
  for (const p of posts) {
    const arr = byTool.get(p.toolSlug) ?? [];
    arr.push(p);
    byTool.set(p.toolSlug, arr);
  }
  return TOOL_SLUGS.map((toolSlug) => ({
    params: { tool: toolSlug },
    props: { releases: byTool.get(toolSlug) ?? [] },
  }));
}

const { tool } = Astro.params;
const { releases } = Astro.props as { releases: ReleasePost[] };
const meta = TOOLS.find((t) => t.slug === tool)!;

const siteUrl = (Astro.site ?? new URL(SITE.url)).toString();
const canonical = canonicalFor(siteUrl, Astro.url.pathname);
const title = `${meta.name} changelog`;
const summary =
  releases.length > 0
    ? `Every ${meta.name} release in one place, newest first (${releases.length} release${releases.length === 1 ? '' : 's'}).`
    : `${meta.name} release history, newest first.`;
// Pad the thin release count with the tool's one-liner, capped at 160 chars.
const fullDescription = `${summary} ${meta.oneLiner}`;
const description =
  fullDescription.length > 160 ? `${fullDescription.slice(0, 157).replace(/\s+\S*$/, '')}...` : fullDescription;

const jsonLd = graph([
  {
    '@type': 'CollectionPage',
    name: title,
    description,
    url: canonical,
  },
  breadcrumbLd([
    { name: 'Lidless', url: 'https://lidless.dev' },
    { name: meta.name, url: `https://lidless.dev/${meta.slug}` },
    { name: 'Changelog', url: canonical },
  ]),
]);

const fmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });

const rendered = await Promise.all(
  releases.map(async (r) => ({ release: r, html: r.body ? await marked.parse(r.body) : '' })),
);
---
<BaseLayout title={title} description={description} jsonLd={jsonLd} robots={releases.length === 0 ? 'noindex, follow' : undefined}>
  <main>
    <header class="phead">
      <div class="wrap"><div class="frame">
        <nav class="crumb" aria-label="Breadcrumb">
          <a href="/">Lidless Labs</a> / <a href="/blog">Changelog</a> / <span>{meta.name}</span>
        </nav>
        <h1><span class="mono">{meta.name}</span> <span class="ver">changelog</span></h1>
        <p class="lede">
          Every {meta.name} release, newest first.
          {PAGES[meta.slug] ? <a href={`/${meta.slug}`}>About {meta.name}</a> : null}
          {PAGES[meta.slug] ? ' \u00b7 ' : null}<a href={meta.repo}>GitHub repo</a>
        </p>
      </div></div>
    </header>

    <div class="wrap">
      {rendered.length === 0 && (
        <section class="sec">
          <h2 class="label">No releases</h2>
          <p class="empty-note">No releases found for {meta.name} in this build. See the <a href={meta.repo}>releases on GitHub</a>.</p>
        </section>
      )}

      {rendered.map(({ release, html }) => (
        <section class="sec rel" aria-labelledby={releaseAnchor(release.version)}>
          <div class="label">
            <h2 id={releaseAnchor(release.version)} class="mono">{release.tag}</h2>
            <small>{fmt(release.date)}</small>
            <div class="links mono"><a href={`/blog/${release.slug}`}>permalink</a> &middot; <a href={release.url}>github</a></div>
          </div>
          {html ? (
            <article class="prose" set:html={html} />
          ) : (
            <p class="empty-note">No written notes for {release.tag}. The diff is on <a href={release.url}>GitHub</a>.</p>
          )}
        </section>
      ))}
      <div class="end"></div>
    </div>
  </main>

  <style>
    .ver { color: var(--text-dim); font-weight: 500; }
    .rel { scroll-margin-top: 72px; }
    .rel .label h2 { margin: 0; font-size: 15px; font-weight: 500; }
    .rel .label h2:target { color: var(--accent); }
    .rel .label small { display: block; color: var(--text-dim); font-size: 12px; margin-top: 2px; }
    .rel .links { font-size: 12px; color: var(--text-dim); margin-top: 10px; }
    .rel .links a { color: var(--text-muted); }
    .rel .links a:hover { color: var(--text); }
    .end { height: 80px; }
  </style>
</BaseLayout>
